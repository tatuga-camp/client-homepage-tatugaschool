[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/tatuga-camp/client-homepage-tatugaschool.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "setup-project"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/setup-project
[branch "implement/sanity"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/implement/sanity
[branch "implement/homepage"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/implement/homepage
